@page
@model DocumentosModel
@{
    ViewData["Title"] = "Mis documentos";
}

<h1>Gestión de documentos legales</h1>
<p>Espacio de: <strong>@Model.Usuario</strong></p>

<!-- enctype="multipart/form-data" es obligatorio: sin esto el archivo no viaja -->
<form method="post" enctype="multipart/form-data" class="formulario">
    <p>
        <label asp-for="Archivo">Documento (PDF, Word o imagen, máximo 5 MB)</label>
        <input asp-for="Archivo" type="file" />
        <span asp-validation-for="Archivo" class="error"></span>
    </p>
    <p>
        <button type="submit">Subir documento</button>
    </p>
</form>

@if (Model.Mensaje is not null)
{
    <p class="ok">@Model.Mensaje</p>
}

<h2>Documentos cargados</h2>

@if (Model.Documentos.Count <= 0)
{
    <p>Todavía no subiste ningún documento.</p>
}
else
{
    <ul class="lista-documentos">
        @foreach (string nombre in Model.Documentos)
        {
            <li>
                <a href="/documentos/@Model.Usuario/@Uri.EscapeDataString(nombre)" target="_blank">@nombre</a>
            </li>
        }
    </ul>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
