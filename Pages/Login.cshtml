@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1 class="centrado">Iniciar sesión</h1>

@if (Model.Aviso is not null)
{
    <p class="aviso centrado">@Model.Aviso</p>
}

<form method="post" class="formulario">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <p>
        <label asp-for="NombreUsuario">Nombre de usuario</label>
        <input asp-for="NombreUsuario" />
        <span asp-validation-for="NombreUsuario" class="error"></span>
    </p>
    <p>
        <label asp-for="Clave">Contraseña</label>
        <input asp-for="Clave" />
        <span asp-validation-for="Clave" class="error"></span>
    </p>
    <p>
        <button type="submit">Ingresar</button>
    </p>
    <p>¿No tenés cuenta? <a asp-page="/Registro">Registrate</a></p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
