@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="centrado">Ocurrió un error</h1>
<p class="centrado">
    No pudimos procesar tu solicitud. Volvé al <a asp-page="/Index">inicio</a> e intentá de nuevo.
</p>

@if (Model.ShowRequestId)
{
    <p class="centrado">
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}
